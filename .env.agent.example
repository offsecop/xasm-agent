# Required platform endpoint. Keep the /api suffix.
AGENT_API_URL=https://asm.example.com/api

# Option A: credentials generated for one dedicated agent in the platform UI.
AGENT_ENROLLMENT_ID=
AGENT_ENROLLMENT_TOKEN=

# Option B: tenant installer credentials. Leave empty when using option A.
AGENT_CLIENT_ID=
AGENT_CLIENT_SECRET=

# Stable, unique identity for this installation. Recommended for containers.
AGENT_INSTALLATION_UID=remote-agent-01

AGENT_NAME=Remote-Agent-01
AGENT_DESCRIPTION="Standalone xASM remote agent"
AGENT_TAGS=remote,scanner
AGENT_MAX_CONCURRENT_JOBS=3
AGENT_JOB_EXECUTION_TIMEOUT=300
XASM_AGENT_IMAGE=xasm-agent:latest
